<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/preferences_nav_graph"
    app:startDestination="@id/dietFragment">

    <fragment
        android:id="@+id/dietFragment"
        android:name="it.unimib.food_alchemy.ui.preferences.DietFragment"
        android:label="DietFragment"
        tools:layout="@layout/fragment_diet">
        <action
            android:id="@+id/action_dietFragment_to_intolerancesFragment"
            app:destination="@id/intolerancesFragment" />
    </fragment>
    <fragment
        android:id="@+id/intolerancesFragment"
        android:name="it.unimib.food_alchemy.ui.preferences.IntolerancesFragment"
        android:label="IntolerancesFragment"
        tools:layout="@layout/fragment_intolerances">
        <action
            android:id="@+id/action_intolerancesFragment_to_excludeIngredientsFragment"
            app:destination="@id/excludeIngredientsFragment" />
        <action
            android:id="@+id/action_intolerancesFragment_to_dietFragment"
            app:destination="@id/dietFragment" />
    </fragment>
    <fragment
        android:id="@+id/excludeIngredientsFragment"
        android:name="it.unimib.food_alchemy.ui.preferences.ExcludeIngredientsFragment"
        android:label="ExcludeIngredientsFragment"
        tools:layout="@layout/fragment_exclude_ingredients">
        <action
            android:id="@+id/action_excludeIngredientsFragment_to_intolerancesFragment"
            app:destination="@id/intolerancesFragment" />
        <action
            android:id="@+id/action_excludeIngredientsFragment_to_mainActivity"
            app:destination="@id/mainActivity" />
    </fragment>
    <include app:graph="@navigation/auth_nav_graph" />
    <activity
        android:id="@+id/mainActivity"
        android:name="it.unimib.food_alchemy.ui.main.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
</navigation>